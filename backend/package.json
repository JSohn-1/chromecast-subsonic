{
  "name": "chromecastaudio",
  "version": "1.0.0",
  "description": "plays subsonic streams to chromecast with a restful api",
  "main": "./dist/index.js",
  "scripts": {
    "build": "rm -rf backend/dist; tsc --build",
    "clean": "tsc --build --clean",
    "run": "node --trace-warnings ./dist/src/index.js",
    "bun-run": "bun ./src/index.ts",
    "test": "jest --detectOpenHandles --silent=false",
    "windowsDebug": "@powershell -Command $env:DEBUG='chromecast-api';node backend/dist/src/index.js > log.txt 2>&1"
  },
  "author": "yacob",
  "license": "ISC",
  "devDependencies": {
    "@babel/core": "^7.24.7",
    "@babel/preset-env": "^7.24.7",
    "@babel/preset-typescript": "^7.24.7",
    "@jest/globals": "^29.7.0",
    "@types/bun": "^1.1.3",
    "@types/chromecast-api": "^0.4.5",
    "@types/express": "^4.17.21",
    "@types/http-proxy": "^1.17.14",
    "@types/jest": "^29.5.12",
    "@types/md5": "^2.3.5",
    "@types/node-fetch": "^2.6.11",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "babel-jest": "^29.7.0",
    "bun-types": "latest",
    "chai": "^5.1.1",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.2",
    "typescript": "^5.5.3"
  },
  "dependencies": {
    "@spotify/web-api-ts-sdk": "^1.2.0",
    "@types/chai": "^4.3.16",
    "@types/uuid": "^9.0.8",
    "chromecast-api": "^0.4.2",
    "cors": "^2.8.5",
    "crypto-random-string": "^3.3.1",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.18.2",
    "http-proxy": "^1.18.1",
    "md5": "^2.3.0",
    "msw": "^2.3.1",
    "node-fetch": "^2.7.0",
    "node-taglib-sharp": "^5.2.3",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5",
    "sqlite": "^5.1.1",
    "subsonic-api": "^2.0.2",
    "ts-node": "^10.9.2",
    "uuid": "^9.0.1"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  }
}
